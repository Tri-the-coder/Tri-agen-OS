TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-default-chat-id
TELEGRAM_WEBHOOK_SECRET=optional-random-secret-token

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Full fallback chain, comma-separated. Overrides OPENROUTER_MODEL entirely
# and is the only way to use a paid model.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3.8-27b:free,apodex/apodex-1.1-mini:free
OPENROUTER_TIMEOUT=25
# Gates the detailed /health diagnostics (quota, credit, key label).
# Without it /health returns booleans only, since the endpoint is public.
HEALTH_TOKEN=generate-a-random-string
PORT=8000

# Slack. Both are secrets - set them in the Render dashboard, never in git.
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Optional. Shared cache for Slack display names; falls back to an in-process
# cache when unset or unreachable. Free Render Key Value has no persistence.
REDIS_URL=
